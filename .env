# ==================== 环境变量配置 ====================
# 所有环境共享的默认配置
# 特定环境会覆盖对应文件中的同名变量

# 应用标题
VITE_APP_TITLE=LUXURY CAR - 豪华汽车租赁后台管理系统

# API 基础路径（开发环境走 Vite 代理）
VITE_API_BASE_URL=/api

# 是否启用 Mock 数据
VITE_ENABLE_MOCK=false

# 是否启用日志（生产环境建议关闭 debug 级别）
VITE_ENABLE_LOGGER=true

# 日志级别: debug | info | warn | error | none
VITE_LOG_LEVEL=debug

# 请求超时时间（毫秒）
VITE_REQUEST_TIMEOUT=15000

# 上传超时时间（毫秒）
VITE_UPLOAD_TIMEOUT=60000